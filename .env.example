# ===== Required =====

# Supabase (backend)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=eyJ...

# Supabase (frontend — publishable anon key)
SUPABASE_KEY=eyJ...

# ===== Required for Fly.io (set via: fly secrets set KEY=value) =====

# Nuxt runtime overrides (must match values above)
NUXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NUXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=eyJ...

# ===== Optional =====

# Google Gemini (transcription)
GEMINI_API_KEY=

# Replicate (ML inference)
REPLICATE_API_TOKEN=

# Stripe (payments)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# CORS origins (comma-separated, set in fly.toml for production)
# CORS_ORIGINS=https://mentionshero.com,https://www.mentionshero.com

# Public site URL
# NUXT_PUBLIC_SITE_URL=https://mentionshero.com
